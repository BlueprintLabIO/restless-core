# Local bootstrap only. `restlessd` loads an ignored `.env` in a source
# checkout without overriding variables supplied by the service manager.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.kimi.com/coding/v1
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Durable credential backend (Authority Plane §2.6 / §8).
# Create one narrowly scoped Authority Service machine identity in Infisical.
INFISICAL_API_URL=https://us.infisical.com
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
# INFISICAL_ORGANIZATION_SLUG=

# Once RESEND_WEBHOOK_SECRET has been imported, point ingress at its reference.
# RESTLESS_RESEND_WEBHOOK_CREDENTIAL=infisical:/companies/aris/RESEND_WEBHOOK_SECRET
