# Local bootstrap only. `restlessd` loads an ignored `.env` in a source
# checkout without overriding variables supplied by the service manager.
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.kimi.com/coding/v1
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Durable credential backend (Authority Plane §2.6 / §8).
# Create one narrowly scoped Authority Service machine identity in Infisical.
INFISICAL_API_URL=https://us.infisical.com
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
# INFISICAL_ORGANIZATION_SLUG=

# Once RESEND_WEBHOOK_SECRET has been imported, point ingress at its reference.
# RESTLESS_RESEND_WEBHOOK_CREDENTIAL=infisical:/companies/aris/RESEND_WEBHOOK_SECRET

# Hosted account-plane inputs. These are written by Restless Cloud's reviewed
# deployment template, not by an owner and not by a source checkout. They are
# commented so this local bootstrap file remains in local entry mode.
#
# RESTLESS_ENTRY_MODE=network
# RESTLESS_ENTRY_ISSUER=https://fleet.example.com
# RESTLESS_ENTRY_JWKS_URL=https://fleet.example.com/.well-known/jwks.json
# RESTLESS_ENTRY_OWNER_ID=00000000-0000-0000-0000-000000000001
# RESTLESS_ENTRY_PLANE_ID=00000000-0000-0000-0000-000000000002
# RESTLESS_ENTRY_HOST=owner-plane.example.com
# RESTLESS_DESIRED_REVISION=1
# RESTLESS_ACCOUNT_PLANE_IMAGE=registry.example.com/restless-core-account-plane@sha256:<64-lowercase-hex>
# RESTLESS_COMPANY_IMAGE=registry.example.com/restless-core-company-runtime@sha256:<64-lowercase-hex>
# RESTLESS_RELEASE_MANIFEST_DIGEST=sha256:<64-lowercase-hex>
# RESTLESS_COCKPIT_DIR=/opt/restless/cockpit
# RESTLESS_PLANE_DATABASE_URL=postgresql://restless:<password>@plane-database/restless
#
# These four values must be independent random bearer credentials of at least
# 32 characters. They are intentionally separate authority boundaries.
# RESTLESS_PLANE_READINESS_TOKEN=
# RESTLESS_CELL_READINESS_TOKEN=
# RESTLESS_ACTIVITY_TOKEN=
# RESTLESS_DELETION_TOKEN=
#
# Fleet's per-plane Runtime bootstrap credential is mounted as one mode-0400
# secret file. The raw credential must not be copied into an environment
# variable, Compose label, command argument or repository file.
# RESTLESS_RUNTIME_BOOTSTRAP_TOKEN_FILE=/run/secrets/runtime_bootstrap_token
