#!/usr/bin/env bash
# Emit the one current Core release manifest from an already generated and
# immutable company-collaboration contract set. There is deliberately no
# identity-only or local-image compatibility mode: a releasable Core is one
# exact source revision, two immutable OCI images, one Compose contract and
# one admitted collaboration contract set.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec node "$root/scripts/create-core-release-manifest.mjs" "$@"
