#!/usr/bin/env bash
# Emit a local Core release preflight record (S27-T4).
#
# This developer-facing probe describes local builds, including local-only image
# IDs when they have not been pushed. It is not promotion evidence. Immutable
# registry promotion is exclusively `restless-core-release.v1`, produced by
# `scripts/create-core-release-manifest.mjs` and `.github/workflows/core-release.yml`.
#
# It refuses to emit a manifest it cannot substantiate. A manifest naming a
# digest that was never built, or a contract version transcribed by hand, still
# fails the preflight rather than giving a developer a confident wrong answer.
#
# Usage:
#   npm --prefix web run build                         # materialises UI identity
#   scripts/restless-release-manifest                  # identity only, no image digests
#   scripts/restless-release-manifest --with-images    # requires all three images built
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

with_images=false
[[ "${1:-}" == "--with-images" ]] && with_images=true

revision="$(git rev-parse HEAD)"
if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  echo "refusing to emit a manifest from a dirty tree: commit or stash first" >&2
  echo "a release manifest names a revision; a dirty tree is not the revision it names" >&2
  exit 1
fi

core_version="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)"

# Contract versions come from the source that defines them, never retyped here.
api_contract="$(sed -n 's/.*API_CONTRACT_VERSION: u32 = \([0-9]*\);.*/\1/p' crates/restlessd/src/release.rs)"
assertion_contract="$(sed -n 's/.*ASSERTION_CONTRACT_VERSION: u32 = \([0-9]*\);.*/\1/p' crates/restlessd/src/entry.rs)"
schema="$(sed -n 's/.*SCHEMA_VERSION: u32 = \([0-9]*\);.*/\1/p' crates/restlessd/src/release.rs)"

for name in core_version api_contract assertion_contract schema; do
  if [[ -z "${!name}" ]]; then
    echo "could not read $name from the source that defines it" >&2
    exit 1
  fi
done

ui_manifest="web/build/core-ui-manifest.json"
if [[ ! -f "$ui_manifest" ]]; then
  echo "Core UI manifest is missing; run npm --prefix web run build first" >&2
  exit 1
fi
# This compact record intentionally carries independent payload, route-manifest
# and combined artifact digests. Cloud can reject route drift separately from a
# byte-level mismatch without re-deriving Core's route hashing contract.
if ! ui_artifact="$(node web/scripts/verify-core-ui-artifact.mjs --json)"; then
  echo "Core UI artifact does not match its manifest; rebuild it before release" >&2
  exit 1
fi

plane_digest=null
runtime_digest=null
ui_image_digest=null
if $with_images; then
  read_digest() {
    local image="$1"
    local digest
    digest="$(docker image inspect "$image" --format '{{index .RepoDigests 0}}' 2>/dev/null || true)"
    if [[ -z "$digest" ]]; then
      # Not pushed, so no repository digest exists yet. The local content ID is
      # exact for a local probe but is NOT a pinnable registry digest, and is
      # labelled as such rather than passed off as one.
      digest="$(docker image inspect "$image" --format '{{.Id}}' 2>/dev/null || true)"
      [[ -n "$digest" ]] && digest="local:$digest"
    fi
    if [[ -z "$digest" ]]; then
      echo "image $image is not built; build it before emitting a manifest with digests" >&2
      exit 1
    fi
    printf '"%s"' "$digest"
  }
  plane_digest="$(read_digest "restless-account-plane:$core_version")"
  runtime_digest="$(read_digest "restless-company-image:$core_version")"
  ui_image_digest="$(read_digest "restless-core-ui:$core_version")"
fi

cat <<JSON
{
  "manifest_version": 1,
  "core_version": "$core_version",
  "source_revision": "$revision",
  "images": {
    "account_plane": $plane_digest,
    "company_runtime": $runtime_digest,
    "core_ui": $ui_image_digest
  },
  "artifacts": {
    "core_ui": $ui_artifact
  },
  "contracts": {
    "api": $api_contract,
    "identity_assertion": $assertion_contract,
    "schema": $schema
  },
  "health": {
    "path": "/health",
    "reports": ["core_version", "source_revision", "api_contract_version", "assertion_contract_version", "schema_version"]
  }
}
JSON
