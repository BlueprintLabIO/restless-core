#!/usr/bin/env bash
# One-command S27-T5 release run. From a clean checkout this builds both
# artifacts, boots a network plane and an initially sleeping `_test` cell,
# mints/uses an assertion, then pauses for the browser observation before
# starting the Runtime. Ctrl-C performs the required teardown.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

for command in cargo curl docker git jq node npm; do
  command -v "$command" >/dev/null || { echo "missing required command: $command" >&2; exit 1; }
done
if [[ -n "$(git status --porcelain)" ]]; then
  echo "refusing network release run from a dirty checkout" >&2
  exit 1
fi

revision="$(git rev-parse HEAD)"
version="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)"
api_contract="$(sed -n 's/.*API_CONTRACT_VERSION: u32 = \([0-9]*\);.*/\1/p' crates/restlessd/src/release.rs)"
assertion_contract="$(sed -n 's/.*ASSERTION_CONTRACT_VERSION: u32 = \([0-9]*\);.*/\1/p' crates/restlessd/src/entry.rs)"
schema_version="$(sed -n 's/.*SCHEMA_VERSION: u32 = \([0-9]*\);.*/\1/p' crates/restlessd/src/release.rs)"
run_id="${RESTLESS_NETWORK_TEST_RUN_ID:-$$}"
company="core27_network_${run_id}_test"
registry_port="${RESTLESS_NETWORK_TEST_REGISTRY_PORT:-15000}"
postgres_port="${RESTLESS_NETWORK_TEST_POSTGRES_PORT:-15432}"
plane_port="${RESTLESS_NETWORK_TEST_PLANE_PORT:-17888}"
jwks_port="${RESTLESS_NETWORK_TEST_JWKS_PORT:-17889}"
port_offset="${RESTLESS_NETWORK_TEST_PORT_OFFSET:-7000}"
coordinator_port="$((7791 + port_offset))"
docker_arch="$(docker info --format '{{.Architecture}}')"
case "$docker_arch" in
  amd64 | x86_64) runtime_arch=amd64 ;;
  arm64 | aarch64) runtime_arch=arm64 ;;
  *)
    echo "unsupported Docker Runtime image architecture: ${docker_arch:-unknown}" >&2
    exit 1
    ;;
esac
prefix="restless-core27-${run_id}"
network="${prefix}-net"
registry="${prefix}-registry"
postgres="${prefix}-postgres"
cell="restless-co-${company}"
cell_volume="restless-vol-${company}"
scratch="$(mktemp -d "/tmp/${prefix}.XXXXXX")"
home="${scratch}/home"
daemon_pid=""
jwks_pid=""

cleanup() {
  set +e
  if [[ -n "$daemon_pid" ]]; then kill "$daemon_pid" 2>/dev/null; wait "$daemon_pid" 2>/dev/null; fi
  if [[ -n "$jwks_pid" ]]; then kill "$jwks_pid" 2>/dev/null; wait "$jwks_pid" 2>/dev/null; fi
  docker rm -f "$cell" "$postgres" "$registry" >/dev/null 2>&1
  docker volume rm "$cell_volume" >/dev/null 2>&1
  docker network rm "$network" >/dev/null 2>&1
  find "$scratch" -depth -delete 2>/dev/null
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

mkdir -p "$home/companies"
cat >"$home/orgintel.toml" <<EOF
database_url = "postgres://restless:restless-test@127.0.0.1:${postgres_port}/restless"
EOF
cat >"$home/companies/${company}.toml" <<EOF
name = "${company}"
mission = "Prove the network cockpit with a bounded test company. Perform no external effect."
spend_ceiling_usd = 0.0
model = "test/unavailable"
model_failover = []
EOF

docker network create "$network" >/dev/null
docker run -d --name "$registry" --network "$network" -p "127.0.0.1:${registry_port}:5000" registry:2 >/dev/null
docker run -d --name "$postgres" --network "$network" -p "127.0.0.1:${postgres_port}:5432" \
  -e POSTGRES_USER=restless -e POSTGRES_PASSWORD=restless-test -e POSTGRES_DB=restless postgres:16-alpine >/dev/null
for _ in {1..30}; do
  docker exec "$postgres" pg_isready -U restless >/dev/null 2>&1 && break
  sleep 1
done
docker exec "$postgres" pg_isready -U restless >/dev/null

npm --prefix web ci
npm --prefix web run build
RESTLESS_SOURCE_REVISION="$revision" cargo build --release -p restlessd

plane_tag="127.0.0.1:${registry_port}/restless/account-plane:${version}"
runtime_tag="127.0.0.1:${registry_port}/restless/company-runtime:${version}"
docker build -f infra/account-plane/Dockerfile --build-arg SOURCE_REVISION="$revision" -t "$plane_tag" .
docker build -f infra/company-image/Dockerfile \
  --build-arg "TARGETARCH=$runtime_arch" \
  --build-arg RESTLESS_CORE_VERSION="$version" \
  --build-arg RESTLESS_SOURCE_REVISION="$revision" \
  --build-arg "RESTLESS_API_CONTRACT_VERSION=$api_contract" \
  --build-arg "RESTLESS_ASSERTION_CONTRACT_VERSION=$assertion_contract" \
  --build-arg "RESTLESS_SCHEMA_VERSION=$schema_version" \
  -t "$runtime_tag" .
docker push "$plane_tag" >/dev/null
docker push "$runtime_tag" >/dev/null
plane_ref="$(docker image inspect "$plane_tag" --format '{{range .RepoDigests}}{{println .}}{{end}}' | awk -v p="127.0.0.1:${registry_port}/restless/account-plane@" 'index($0,p)==1 {print; exit}')"
runtime_ref="$(docker image inspect "$runtime_tag" --format '{{range .RepoDigests}}{{println .}}{{end}}' | awk -v p="127.0.0.1:${registry_port}/restless/company-runtime@" 'index($0,p)==1 {print; exit}')"
[[ -n "$plane_ref" && -n "$runtime_ref" ]] || { echo "pushed image digest did not resolve" >&2; exit 1; }

export RESTLESS_HOME="$home"
export RESTLESS_PROFILE=dev
export RESTLESS_PORT_OFFSET="$port_offset"
export RESTLESS_RESOURCE_NAMESPACE="network-${port_offset}"
export RESTLESS_OWNER_ADDR="0.0.0.0:${plane_port}"
export RESTLESS_ENTRY_MODE=network
export RESTLESS_ENTRY_ALLOW_INSECURE_HTTP=1
export RESTLESS_ENTRY_ISSUER="http://localhost:${jwks_port}"
export RESTLESS_ENTRY_JWKS_URL="http://localhost:${jwks_port}/.well-known/jwks.json"
export RESTLESS_ENTRY_OWNER_ID=018f0000-0000-7000-8000-000000000001
export RESTLESS_ENTRY_PLANE_ID=018f0000-0000-7000-8000-000000000002
export RESTLESS_ENTRY_HOST=restless.localhost
export RESTLESS_ENTRY_TEST_SIGNING_KEY_B64=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=
export RESTLESS_ENTRY_TEST_SIGNING_KEY_ID=core27-test-v1
export RESTLESS_ENTRY_TEST_COMPANY_ID=018f0000-0000-7000-8000-000000000003
export RESTLESS_ENTRY_TEST_CELL_ID=018f0000-0000-7000-8000-000000000004
export RESTLESS_ENTRY_TEST_MEMBERSHIP_ID=core27-test-membership
mkdir -p "$scratch/.well-known"
cat >"$scratch/.well-known/jwks.json" <<'EOF'
{"keys":[{"kty":"OKP","crv":"Ed25519","alg":"EdDSA","use":"sig","kid":"core27-test-v1","x":"6kpsY-KcUgq-9VB7Ey7F-ZVHdq6-vnuSQh7qaRRG0iw"}]}
EOF
node -e 'const http=require("node:http"),fs=require("node:fs"),path=require("node:path");const root=process.argv[1],port=Number(process.argv[2]);http.createServer((request,response)=>{const file=path.join(root,request.url);if(request.url!=="/.well-known/jwks.json"){response.writeHead(404).end();return}response.writeHead(200,{"content-type":"application/json"});response.end(fs.readFileSync(file))}).listen(port,"127.0.0.1")' "$scratch" "$jwks_port" &
jwks_pid="$!"
for _ in {1..30}; do
  curl -fsS "http://localhost:${jwks_port}/.well-known/jwks.json" >/dev/null 2>&1 && break
  kill -0 "$jwks_pid" 2>/dev/null || { echo "test JWKS server exited" >&2; exit 1; }
  sleep 1
done
export RESTLESS_COMPANY_IMAGE="$runtime_ref"
target/release/restlessd >"$scratch/plane.log" 2>&1 &
daemon_pid="$!"
plane_url="http://restless.localhost:${plane_port}"
for _ in {1..30}; do
  curl -fsS --resolve "restless.localhost:${plane_port}:127.0.0.1" \
    "${plane_url}/health" >"$scratch/plane-health.json" 2>/dev/null && break
  kill -0 "$daemon_pid" 2>/dev/null || { cat "$scratch/plane.log" >&2; exit 1; }
  sleep 1
done
jq -e --arg revision "$revision" '.release.source_revision == $revision' "$scratch/plane-health.json" >/dev/null

target/release/restlessd mint-entry-assertion >"$scratch/assertion.txt"
chmod 0600 "$scratch/assertion.txt"
assertion="$(tail -1 "$scratch/assertion.txt")"
entry_status="$(curl -sS --resolve "restless.localhost:${plane_port}:127.0.0.1" \
  -D "$scratch/entry-headers.txt" -o "$scratch/entry-response.json" -w '%{http_code}' \
  -c "$scratch/cookies.txt" -H 'Content-Type: application/x-www-form-urlencoded' \
  --data-urlencode "assertion=${assertion}" "${plane_url}/entry")"
[[ "$entry_status" == 303 ]] || {
  cat "$scratch/entry-response.json" >&2
  echo "form entry exchange returned HTTP ${entry_status}, expected 303" >&2
  exit 1
}
session_token="$(sed -n 's/^[Ss]et-[Cc]ookie: restless_session=\([^;[:space:]]*\).*/\1/p' "$scratch/entry-headers.txt" | tail -1)"
[[ -n "$session_token" ]] || { echo "entry exchange did not establish a browser session" >&2; exit 1; }
# Production sessions are Secure. curl correctly refuses to replay that cookie
# over this harness's loopback HTTP endpoint, so make the test-only replay
# explicit instead of weakening the production cookie.
session_header="Cookie: restless_session=${session_token}"

replay_status="$(curl -sS --resolve "restless.localhost:${plane_port}:127.0.0.1" \
  -o "$scratch/entry-replay.json" -w '%{http_code}' \
  -H 'Content-Type: application/x-www-form-urlencoded' \
  --data-urlencode "assertion=${assertion}" "${plane_url}/entry")"
[[ "$replay_status" == 401 ]] || {
  cat "$scratch/entry-replay.json" >&2
  echo "replayed entry assertion returned HTTP ${replay_status}, expected 401" >&2
  exit 1
}
jq -e '.error == "assertion_replayed"' "$scratch/entry-replay.json" >/dev/null

wrong_host_status="$(curl -sS -o "$scratch/wrong-host.json" -w '%{http_code}' \
  -H "$session_header" "http://127.0.0.1:${plane_port}/api/companies/${company}/cockpit")"
[[ "$wrong_host_status" == 403 ]] || {
  cat "$scratch/wrong-host.json" >&2
  echo "wrong-host request returned HTTP ${wrong_host_status}, expected 403" >&2
  exit 1
}
jq -e '.error == "network_owner_boundary"' "$scratch/wrong-host.json" >/dev/null

out_of_scope_company="${company}_other"
out_of_scope_status="$(curl -sS --resolve "restless.localhost:${plane_port}:127.0.0.1" \
  -o "$scratch/out-of-scope.json" -w '%{http_code}' -H "$session_header" \
  "${plane_url}/api/companies/${out_of_scope_company}/cockpit")"
[[ "$out_of_scope_status" == 403 ]] || {
  cat "$scratch/out-of-scope.json" >&2
  echo "out-of-scope company request returned HTTP ${out_of_scope_status}, expected 403" >&2
  exit 1
}
jq -e '.error == "company_out_of_scope"' "$scratch/out-of-scope.json" >/dev/null

curl -fsS --resolve "restless.localhost:${plane_port}:127.0.0.1" -H "$session_header" \
  "${plane_url}/api/companies/${company}/cockpit" >"$scratch/cockpit-asleep.json"

echo "release revision: $revision"
echo "account plane:    $plane_ref"
echo "Runtime:          $runtime_ref"
echo "cockpit:          ${plane_url}/${company}"
echo "test assertion:   $scratch/assertion.txt"
echo "sleeping cockpit probe: PASS"
echo "entry replay, host, and company scope probes: PASS"

if [[ "${RESTLESS_NETWORK_TEST_AUTO_WAKE:-0}" != 1 ]]; then
  echo "Open the cockpit and verify the sleeping-cell state, then press Return to start the Runtime."
  read -r _
fi

docker volume create "$cell_volume" >/dev/null
docker run -d --name "$cell" --network bridge -v "${cell_volume}:/company" \
  -e RESTLESS_COMPANY="$company" \
  -e RESTLESS_COORDINATOR="host.docker.internal:${coordinator_port}" \
  "$runtime_ref" >/dev/null
for _ in {1..30}; do
  docker exec "$cell" curl -fsS http://127.0.0.1:7789/health >"$scratch/cell-health.json" 2>/dev/null && break
  sleep 1
done
jq -e --arg revision "$revision" '.release.source_revision == $revision' "$scratch/cell-health.json" >/dev/null
curl -fsS --resolve "restless.localhost:${plane_port}:127.0.0.1" -H "$session_header" \
  "${plane_url}/api/companies/${company}/cockpit" >"$scratch/cockpit-awake.json"
echo "awake Runtime health and cockpit probes: PASS"

if [[ "${RESTLESS_NETWORK_TEST_KEEP_RUNNING:-1}" == 1 ]]; then
  echo "Verify the awake state in the same browser. Press Return (or Ctrl-C) to tear everything down."
  read -r _
fi
