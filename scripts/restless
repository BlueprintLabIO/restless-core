#!/usr/bin/env bash
# PATH entry for the owner CLI. Builds before every invocation and execs the
# build output directly, so the command on PATH can never lag the working tree.
# A failed build stops here rather than silently running the previous binary.
set -euo pipefail

CLI_SCRIPT_PATH="$0"
while [ -L "$CLI_SCRIPT_PATH" ]; do
  CLI_LINK_DIR="$(cd "$(dirname "$CLI_SCRIPT_PATH")" && pwd)"
  CLI_LINK_TARGET="$(readlink "$CLI_SCRIPT_PATH")"
  case "$CLI_LINK_TARGET" in
    /*) CLI_SCRIPT_PATH="$CLI_LINK_TARGET" ;;
    *) CLI_SCRIPT_PATH="${CLI_LINK_DIR}/${CLI_LINK_TARGET}" ;;
  esac
done
CLI_SCRIPT_DIR="$(cd "$(dirname "$CLI_SCRIPT_PATH")" && pwd)"
CLI_REPO_ROOT="$(cd "${CLI_SCRIPT_DIR}/.." && pwd)"
CLI_TARGET_DIR="${CLI_REPO_ROOT}/target"

# debug matches what restless-dev runs, so both paths exercise one binary.
CLI_PROFILE="${RESTLESS_PROFILE:-debug}"
case "$CLI_PROFILE" in
  debug) CLI_PROFILE_FLAG="" ;;
  release) CLI_PROFILE_FLAG="--release" ;;
  *) printf 'RESTLESS_PROFILE must be debug or release, got %s\n' "$CLI_PROFILE" >&2; exit 2 ;;
esac

if ! cargo build --quiet --manifest-path "${CLI_REPO_ROOT}/Cargo.toml" \
  --target-dir "$CLI_TARGET_DIR" ${CLI_PROFILE_FLAG} -p restless; then
  printf 'restless failed to build; refusing to run a stale binary.\n' >&2
  exit 1
fi

exec "${CLI_TARGET_DIR}/${CLI_PROFILE}/restless" "$@"
