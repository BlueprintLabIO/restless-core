# Core nightly smokes (scripts/release/local/nightly.sh). Install:
#   cp scripts/release/local/systemd/restless-core-nightly.* ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now restless-core-nightly.timer
[Unit]
Description=Restless Core nightly smokes (connections and multiplayer)

[Service]
Type=oneshot
WorkingDirectory=%h/code/work/ghapp-fix
ExecStart=%h/code/work/ghapp-fix/scripts/release/local/nightly.sh
Nice=10
TimeoutStartSec=3h
