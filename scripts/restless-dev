#!/usr/bin/env bash
# One foreground owner stack for local development. Durable company containers
# and volumes outlive this process; only host processes started here are stopped
# when the terminal closes.
set -euo pipefail

STACK_SCRIPT_PATH="$0"
while [ -L "$STACK_SCRIPT_PATH" ]; do
  STACK_LINK_DIR="$(cd "$(dirname "$STACK_SCRIPT_PATH")" && pwd)"
  STACK_LINK_TARGET="$(readlink "$STACK_SCRIPT_PATH")"
  case "$STACK_LINK_TARGET" in
    /*) STACK_SCRIPT_PATH="$STACK_LINK_TARGET" ;;
    *) STACK_SCRIPT_PATH="${STACK_LINK_DIR}/${STACK_LINK_TARGET}" ;;
  esac
done
STACK_SCRIPT_DIR="$(cd "$(dirname "$STACK_SCRIPT_PATH")" && pwd)"
STACK_REPO_ROOT="$(cd "${STACK_SCRIPT_DIR}/.." && pwd)"
source "${STACK_SCRIPT_DIR}/lib/dev-company.sh"
source "${STACK_SCRIPT_DIR}/lib/dev-database.sh"
source "${STACK_SCRIPT_DIR}/lib/dev-release.sh"
source "${STACK_SCRIPT_DIR}/lib/dev-worktree.sh"
source "${STACK_SCRIPT_DIR}/lib/dev-tools.sh"
source "${STACK_SCRIPT_DIR}/lib/dev-vault.sh"
# A development checkout is a named appliance profile, never an accidental
# client of the founder's stable singleton. The namespace and offset are
# deterministic for this checkout so restarts reconnect to their own state,
# while two checkouts cannot share ports, databases, containers or volumes.
STACK_REPO_CHECKSUM="$(printf '%s' "$STACK_REPO_ROOT" | cksum | awk '{print $1}')"
STACK_NAMESPACE="${RESTLESS_RESOURCE_NAMESPACE:-dev${STACK_REPO_CHECKSUM}}"
if ! [[ "$STACK_NAMESPACE" =~ ^[a-z][a-z0-9_-]{0,23}$ ]]; then
  printf 'RESTLESS_RESOURCE_NAMESPACE must use 1..24 lowercase letters, digits, underscores or hyphens, starting with a letter.\n' >&2
  exit 2
fi
STACK_OFFSET="${RESTLESS_PORT_OFFSET:-$((1000 + STACK_REPO_CHECKSUM % 18000))}"
if ! [[ "$STACK_OFFSET" =~ ^[0-9]{4,5}$ ]] ||
   ((10#$STACK_OFFSET < 1000 || 10#$STACK_OFFSET >= 20000)); then
  printf 'RESTLESS_PORT_OFFSET must be in 1000..19999 for a development profile.\n' >&2
  exit 2
fi
STACK_OFFSET="$((10#$STACK_OFFSET))"
STACK_STATE_ROOT="${RESTLESS_HOME:-${HOME}/.restless-dev/${STACK_NAMESPACE}}"
export RESTLESS_PROFILE="dev"
export RESTLESS_RESOURCE_NAMESPACE="$STACK_NAMESPACE"
export RESTLESS_PORT_OFFSET="$STACK_OFFSET"
export RESTLESS_HOME="$STACK_STATE_ROOT"
STACK_COMPANY_IMAGE="${RESTLESS_COMPANY_IMAGE:-restless-company-image:${STACK_NAMESPACE}}"
export RESTLESS_COMPANY_IMAGE="$STACK_COMPANY_IMAGE"
STACK_DOCUMENTS_IMAGE="${RESTLESS_NATIVE_DOCUMENTS_IMAGE:-restless-native-documents:${STACK_NAMESPACE}}"
export RESTLESS_NATIVE_DOCUMENTS_IMAGE="$STACK_DOCUMENTS_IMAGE"
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "help" ]; then
  STACK_ACTION="help"
  STACK_COMPANY="aris"
  STACK_RECONCILE=""
elif [ "${1:-}" = "worktree" ] || [ "${1:-}" = "promote" ] || [ "${1:-}" = "reap-timer" ]; then
  STACK_ACTION="$1"
  STACK_COMPANY="aris"
  STACK_RECONCILE=""
  shift
  STACK_ARGS=("$@")
elif [ "${1:-}" = "doctor" ]; then
  STACK_ACTION="doctor"
  STACK_COMPANY="${2:-aris}"
  STACK_RECONCILE=""
elif [ "${1:-}" = "dev" ]; then
  # Keep the old spelling temporarily so an open terminal does not become a trap.
  STACK_ACTION="dev"
  STACK_COMPANY="${2:-aris}"
  STACK_RECONCILE="${3:-}"
else
  STACK_ACTION="dev"
  STACK_COMPANY="${1:-aris}"
  STACK_RECONCILE="${2:-}"
fi
STACK_OWNER_URL="${RESTLESS_OWNER_URL:-http://127.0.0.1:$((7788 + STACK_OFFSET))}"
STACK_WEB_PORT="${RESTLESS_WEB_PORT:-$((5173 + STACK_OFFSET))}"
STACK_WEB_URL="http://127.0.0.1:${STACK_WEB_PORT}"
export RESTLESS_OWNER_URL="$STACK_OWNER_URL"
STACK_TARGET_DIR="${RESTLESS_DEV_TARGET_DIR:-${STACK_REPO_ROOT}/target-dev}"
STACK_DAEMON_PID=""
STACK_WEB_PID=""

usage() {
  cat <<'EOF'
usage:
  restless-dev [company] [--reconcile]
  restless-dev doctor [company]
  restless-dev worktree new <name> | stale | prune
  restless-dev promote [ref] [--build-only] [--force] [--skip-smoke]
  restless-dev reap-timer install | remove

dev owns the foreground daemon and Vite processes it starts. Ctrl-C stops
those host processes, while the company's persistent container and volume stay up.
doctor is read-only and exits non-zero when any boundary is unavailable.

Every checkout uses an explicit dev profile. The chosen state root, resource
namespace and port offset are printed before any mutation.

For a new company, connect Codex, Claude or an API provider in Company > Intelligence
after startup. To initialise an API connection from your shell, set both
RESTLESS_DEV_MODEL=provider/model and RESTLESS_DEV_CREDENTIAL_REFERENCE=env:YOUR_API_KEY.
Existing companies keep their settings.

worktree new starts a branch from a fresh origin/main in an idle pooled slot
(work/slot-N), keeping its build cache warm. stale lists every worktree's age,
uncommitted files, commits no remote has and claim. prune releases slots whose
task has landed and removes other worktrees that are clean, fully pushed and
unused; RESTLESS_WORKTREE_POOL_SIZE (default 4) slots are kept warm.

promote builds one origin/main commit (default: origin/main) in a clean build
worktree and installs it as the owner's stable appliance through
`restless appliance upgrade`, which drains work and rolls back on failure. It
refuses any commit that is not on origin/main, and any build that fails
scripts/connections-smoke (--skip-smoke overrides, loudly).

reap-timer installs an hourly `restless-reap --check` (systemd on Linux).
EOF
}

pass() { printf 'PASS  %s\n' "$1"; }
fail() { printf 'FAIL  %s\n' "$1" >&2; STACK_FAILURES=$((STACK_FAILURES + 1)); }

require_command() {
  if command -v "$1" >/dev/null 2>&1; then
    pass "$1 is installed"
  else
    fail "$1 is not installed"
  fi
}

http_status() {
  curl --max-time 3 --silent --output /dev/null --write-out '%{http_code}' "$1" 2>/dev/null || true
}

gateway_is_live() {
  local status
  status="$(http_status "${STACK_OWNER_URL}/api/companies")"
  [ "$status" = "200" ] || [ "$status" = "401" ]
}

web_proxy_is_live() {
  local status
  status="$(http_status "${STACK_WEB_URL}/api/companies")"
  [ "$status" = "200" ] || [ "$status" = "401" ]
}

wait_for_gateway() {
  local probe_attempt
  for ((probe_attempt = 0; probe_attempt < 80; probe_attempt += 1)); do
    gateway_is_live && return 0
    sleep 0.25
  done
  return 1
}

wait_for_web_proxy() {
  local probe_attempt
  for ((probe_attempt = 0; probe_attempt < 80; probe_attempt += 1)); do
    web_proxy_is_live && return 0
    sleep 0.25
  done
  return 1
}

wait_for_admission() {
  local probe_attempt
  for ((probe_attempt = 0; probe_attempt < 120; probe_attempt += 1)); do
    if curl --fail --silent --max-time 2 "${STACK_OWNER_URL}/api/appliance" \
      | jq --exit-status '.recovering == false and .draining == false' >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
  done
  printf 'Startup recovery has not finished. Inspect the daemon output before retrying.\n' >&2
  return 1
}

check_disk_headroom() {
  local available_kb
  available_kb="$(df -Pk "${STACK_REPO_ROOT}" | awk 'END {print $4}')"
  if [ -n "$available_kb" ] && [ "$available_kb" -ge $((30 * 1024 * 1024)) ]; then
    pass "host has at least 30 GiB free"
  else
    fail "host has less than 30 GiB free; clean build storage before a full build"
  fi
}

doctor() {
  if [ ! -x "${STACK_TARGET_DIR}/debug/restless" ]; then
    printf 'restless is not built; run restless-dev %s first.\n' "$STACK_COMPANY" >&2
    return 1
  fi
  RESTLESS_OWNER_URL="$STACK_OWNER_URL" \
    RESTLESS_COCKPIT_URL="$STACK_WEB_URL" \
    "${STACK_TARGET_DIR}/debug/restless" doctor -c "$STACK_COMPANY"
}

wait_for_doctor() {
  local probe_attempt
  for ((probe_attempt = 0; probe_attempt < 40; probe_attempt += 1)); do
    if RESTLESS_OWNER_URL="$STACK_OWNER_URL" \
      RESTLESS_COCKPIT_URL="$STACK_WEB_URL" \
      "${STACK_TARGET_DIR}/debug/restless" doctor -c "$STACK_COMPANY" \
      >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

cleanup_children() {
  local exit_code=$?
  trap - EXIT INT TERM
  if [ -n "$STACK_WEB_PID" ] && kill -0 "$STACK_WEB_PID" 2>/dev/null; then
    kill "$STACK_WEB_PID" 2>/dev/null || true
    wait "$STACK_WEB_PID" 2>/dev/null || true
  fi
  if [ -n "$STACK_DAEMON_PID" ] && kill -0 "$STACK_DAEMON_PID" 2>/dev/null; then
    kill "$STACK_DAEMON_PID" 2>/dev/null || true
    wait "$STACK_DAEMON_PID" 2>/dev/null || true
  fi
  exit "$exit_code"
}

dev() {
  local company_created=""
  case "$STACK_RECONCILE" in
    ""|--reconcile) ;;
    *) usage >&2; exit 2 ;;
  esac

  # Fail before expensive builds or starting services when first-run intent is missing.
  if [ ! -f "${RESTLESS_HOME}/companies/${STACK_COMPANY}.toml" ]; then
    dev_company_validate || return 1
  fi

  STACK_FAILURES=0
  require_command cargo
  require_command curl
  require_command docker
  require_command npm
  require_command node
  require_command jq
  require_command openssl
  check_disk_headroom
  [ "$STACK_FAILURES" -eq 0 ] || return 1
  docker info >/dev/null 2>&1 || {
    printf 'Docker is not reachable. Start Docker and check that your user can run docker info.\n' >&2
    return 1
  }
  docker compose version >/dev/null 2>&1 || {
    printf 'Docker Compose v2 is required for the built-in vault. Install the Docker Compose plugin, then retry.\n' >&2
    return 1
  }
  if [ ! -d "${STACK_REPO_ROOT}/web/node_modules" ]; then
    printf 'Cockpit dependencies are absent. Run npm --prefix web ci, then retry.\n' >&2
    return 1
  fi

  printf 'PROFILE  dev\nROOT     %s\nNAMESPACE %s\nOFFSET   %s\nIMAGE    %s\n' \
    "$RESTLESS_HOME" "$RESTLESS_RESOURCE_NAMESPACE" "$RESTLESS_PORT_OFFSET" \
    "$RESTLESS_COMPANY_IMAGE"

  # The owner gateway also serves entry and workspace pages. It needs its SPA
  # even when the development UI will subsequently run through Vite.
  if [ "$STACK_RECONCILE" = "--reconcile" ] || [ ! -f "${STACK_REPO_ROOT}/web/build/index.html" ]; then
    printf '\nBuilding the workspace pages…\n'
    npm --prefix "${STACK_REPO_ROOT}/web" run build
  fi

  printf '\nBuilding Restless. The first build can take several minutes.\n'
  # A newer stack start in this checkout supersedes a build still running.
  "${STACK_REPO_ROOT}/scripts/restless-cargo" build --manifest-path "${STACK_REPO_ROOT}/Cargo.toml" \
    --target-dir "$STACK_TARGET_DIR" -p restlessd -p restless

  # Documents are part of the same checkout release as the daemon and Runtime.
  # Never reuse another checkout's mutable :local sidecar after a source update.
  if [ "$STACK_RECONCILE" = "--reconcile" ] || ! docker image inspect "$STACK_DOCUMENTS_IMAGE" >/dev/null 2>&1; then
    printf '\nBuilding the shared document service…\n'
    docker build --tag "$STACK_DOCUMENTS_IMAGE" \
      "${STACK_REPO_ROOT}/services/native-documents-collaboration"
  fi

  # Local development owns its source build. The account plane only consumes
  # an image reference, matching the hosted path where Fleet publishes and
  # pins the Runtime artifact before asking a plane to reconcile it.
  if [ "$STACK_RECONCILE" = "--reconcile" ]; then
    printf '\nBuilding the company computer and its tools…\n'
    dev_build_company_image "$STACK_REPO_ROOT" "$RESTLESS_COMPANY_IMAGE" ""
  elif ! docker image inspect "$RESTLESS_COMPANY_IMAGE" >/dev/null 2>&1; then
    # Snapshot the current stable development image into this checkout's
    # namespace. Future dev rebuilds can no longer mutate the image selected by
    # the stable appliance or by a different checkout.
    if docker image inspect restless-company-image:latest >/dev/null 2>&1; then
      docker tag restless-company-image:latest "$RESTLESS_COMPANY_IMAGE"
    else
      printf 'No Runtime image exists for this checkout. Rerun with --reconcile.\n' >&2
      return 1
    fi
  fi

  if [ "$(http_status "${STACK_WEB_URL}/${STACK_COMPANY}")" = "200" ]; then
    if [ "$STACK_RECONCILE" = "--reconcile" ]; then
      "${STACK_TARGET_DIR}/debug/restless" up -c "$STACK_COMPANY" --reconcile
    fi
    if wait_for_doctor && doctor; then
      printf 'The local stack is already running; no second stack was started.\n'
      return 0
    fi
    printf 'Port %s is occupied by an inconsistent web stack; stop it, then rerun this command.\n' "$STACK_WEB_PORT" >&2
    return 1
  fi

  trap cleanup_children EXIT INT TERM
  if ! gateway_is_live; then
    dev_database_ensure || return 1
    dev_tools_ensure || return 1
    dev_vault_ensure || return 1
    (cd "$STACK_REPO_ROOT" && exec "${STACK_TARGET_DIR}/debug/restlessd") &
    STACK_DAEMON_PID=$!
    wait_for_gateway || {
      printf 'Owner gateway did not become ready. See the daemon output above.\n' >&2
      return 1
    }
  fi

  # A readable cockpit can precede safe write admission during crash recovery.
  # Wait before creating a company or starting its computer.
  wait_for_admission || return 1

  if [ ! -f "${RESTLESS_HOME}/companies/${STACK_COMPANY}.toml" ]; then
    local company_file
    company_file="$(mktemp "${TMPDIR:-/tmp}/restless-dev-company.XXXXXX")"
    dev_company_write "$STACK_COMPANY" >"$company_file"
    if ! "${STACK_TARGET_DIR}/debug/restless" company create --from-file "$company_file"; then
      rm -f "$company_file"
      return 1
    fi
    rm -f "$company_file"
    company_created="yes"
  fi

  # The daemon freezes its admitted model routes at boot. A first-run company
  # created through the canonical API therefore gets one immediate supervised
  # restart before any Runtime is started; otherwise the fresh profile would
  # look healthy while its new company could not think until the next day.
  if [ "$company_created" = "yes" ] && [ -n "$STACK_DAEMON_PID" ]; then
    kill "$STACK_DAEMON_PID"
    wait "$STACK_DAEMON_PID" || true
    (cd "$STACK_REPO_ROOT" && exec "${STACK_TARGET_DIR}/debug/restlessd") &
    STACK_DAEMON_PID=$!
    wait_for_gateway || {
      printf 'Owner gateway did not return after first-company admission.\n' >&2
      return 1
    }
    wait_for_admission || return 1
  fi

  local up_args=(up -c "$STACK_COMPANY")
  [ "$STACK_RECONCILE" = "--reconcile" ] && up_args+=(--reconcile)
  "${STACK_TARGET_DIR}/debug/restless" "${up_args[@]}"

  if [ ! -d "${STACK_REPO_ROOT}/web/node_modules" ]; then
    printf 'web/node_modules is absent; run npm --prefix web install first.\n' >&2
    return 1
  fi

  (
    cd "${STACK_REPO_ROOT}/web"
    exec ./node_modules/.bin/vite dev --host 127.0.0.1 --port "$STACK_WEB_PORT" --strictPort
  ) &
  STACK_WEB_PID=$!
  wait_for_web_proxy || {
    printf 'Cockpit did not become ready. See the Vite output above.\n' >&2
    return 1
  }

  if [ "$company_created" = "yes" ] && [ -z "${RESTLESS_DEV_CREDENTIAL_REFERENCE:-}" ]; then
    # Keep the setup UI available while the owner connects their chosen harness.
    printf '\nConnect your intelligence provider at %s/%s/company/provider\n' "$STACK_WEB_URL" "$STACK_COMPANY"
    printf 'Then verify the connection with: restless-dev doctor %s\n' "$STACK_COMPANY"
    doctor || true
  else
    if wait_for_doctor; then
      doctor
    else
      # A partially configured company must remain reachable after a restart too.
      # Doctor retains its strict failure status; this foreground command owns the UI.
      doctor || true
      printf '\nWorkspace remains available at %s/%s/company/provider\n' "$STACK_WEB_URL" "$STACK_COMPANY"
      printf 'Resolve the failed checks above, then rerun restless-dev doctor %s.\n' "$STACK_COMPANY"
    fi
  fi
  printf '\nPress Ctrl-C to stop the host daemon and Vite processes started here.\n'
  wait "$STACK_WEB_PID"
}

if ! [[ "$STACK_COMPANY" =~ ^[a-z][a-z0-9_]{0,62}$ ]]; then
  printf 'invalid company name: %s\n' "$STACK_COMPANY" >&2
  exit 2
fi

# Resource debt is reported alongside the explicit doctor, not inside doctor()
# — wait_for_doctor polls that up to 40 times and this shells out to Docker.
# It reports and never changes doctor's exit status: debt is an operator
# decision, and a stack that works should not fail its health check over it.
report_resource_debt() {
  local reaper="${STACK_SCRIPT_DIR}/restless-reap"
  [ -x "$reaper" ] || return 0
  printf '\n'
  "$reaper" --check || true
}

# Build one origin/main commit and hand it to the appliance. The appliance owns
# activation, drain and rollback; this only produces the exact artifacts.
promote() {
  local ref="origin/main" build_only=false skip_smoke=false
  local appliance_args=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --build-only) build_only=true ;;
      --skip-smoke) skip_smoke=true ;;
      --force) appliance_args+=("--force") ;;
      -*) printf 'unknown promote option %s\n' "$1" >&2; return 2 ;;
      *) ref="$1" ;;
    esac
    shift
  done
  git -C "$STACK_REPO_ROOT" fetch --quiet origin
  local commit
  commit="$(git -C "$STACK_REPO_ROOT" rev-parse --verify "${ref}^{commit}")"
  if ! git -C "$STACK_REPO_ROOT" merge-base --is-ancestor "$commit" origin/main; then
    printf 'refusing to promote %s: it is not on origin/main. Land it first.\n' "$commit" >&2
    return 1
  fi
  local short="${commit:0:12}"
  local build_root="${RESTLESS_PROMOTE_ROOT:-${HOME}/.cache/restless/promote}"
  local source="${build_root}/source"
  local tools_root="${HOME}/.local/lib/restless/host-tools"
  mkdir -p "$build_root"
  if [ -d "$source" ]; then
    git -C "$source" checkout --quiet --detach "$commit"
    git -C "$source" clean -fdq -e web/node_modules
  else
    git -C "$STACK_REPO_ROOT" worktree add --detach "$source" "$commit"
  fi
  printf 'PROMOTE  %s (%s)\n' "$short" "$(git -C "$source" log -1 --format=%s)"

  printf '\nBuilding Restless (release)…\n'
  "${STACK_REPO_ROOT}/scripts/restless-cargo" build --release --manifest-path "${source}/Cargo.toml" \
    --target-dir "${build_root}/target" -p restlessd -p restless
  printf '\nBuilding the Cockpit…\n'
  npm --prefix "${source}/web" ci --no-audit --no-fund
  npm --prefix "${source}/services/native-sheets" ci --no-audit --no-fund
  npm --prefix "${source}/services/native-sheets" test
  npm --prefix "${source}/web" run build
  printf '\nInstalling the model broker…\n'
  local tools
  tools="$(dev_install_host_tools "$source" "$tools_root")"
  local sheets
  sheets="$(dev_install_sheets "$source" "$tools_root")"
  printf '\nBuilding the company computer and document service…\n'
  dev_build_company_image "$source" "restless-company-image:${short}" "$commit"
  docker build --tag "restless-native-documents:${short}" \
    "${source}/services/native-documents-collaboration"

  # Connections are what let the company act through the owner's tools; prove
  # they hold on these exact binaries and image before anything is activated.
  if [ "$skip_smoke" = true ]; then
    printf '\nWARNING: --skip-smoke: promoting %s without the connections smoke.\n' "$short" >&2
  elif [ -x "${source}/scripts/connections-smoke" ]; then
    printf '\nChecking connections on this build…\n'
    if ! RESTLESSD_BIN="${build_root}/target/release/restlessd" \
         RESTLESS_COMPANY_IMAGE="restless-company-image:${short}" \
         RESTLESS_OMP_BIN="${tools}/omp-source" \
         python3 "${source}/scripts/connections-smoke" --target core \
           --output "${build_root}/connections-smoke-${short}"; then
      printf 'The connections smoke failed on %s; nothing was activated. Evidence: %s\n' \
        "$short" "${build_root}/connections-smoke-${short}/evidence.json" >&2
      return 1
    fi
  fi

  local release_env="${build_root}/release.env"
  cat >"$release_env" <<EOF_RELEASE
RESTLESS_SOURCE_COMMIT=${commit}
RESTLESS_COMPANY_IMAGE=restless-company-image:${short}
RESTLESS_NATIVE_DOCUMENTS_IMAGE=restless-native-documents:${short}
RESTLESS_OMP_BIN=${tools}/omp-source
RESTLESS_SHEETS_WORKER=${sheets}/src/worker.mjs
RESTLESS_NODE_BIN=${sheets}/bin/node
EOF_RELEASE

  if [ "$build_only" = true ]; then
    printf '\nBuilt %s; not activated (--build-only).\n' "$short"
    return 0
  fi
  printf '\nActivating through the appliance…\n'
  local installed="${HOME}/.local/lib/restless/current"
  local verb=upgrade
  [ -e "$installed" ] || verb=install
  env -u RESTLESS_HOME -u RESTLESS_PORT_OFFSET -u RESTLESS_RESOURCE_NAMESPACE \
    -u RESTLESS_COMPANY_IMAGE -u RESTLESS_NATIVE_DOCUMENTS_IMAGE -u RESTLESS_OWNER_URL \
    RESTLESS_PROFILE=stable \
    "${build_root}/target/release/restless" appliance "$verb" \
      --daemon "${build_root}/target/release/restlessd" \
      --cockpit "${source}/web/build" \
      --release-environment "$release_env" \
      "${appliance_args[@]}"
  dev_prune_host_tools "$tools_root"
}

# Remove broker installs no retained release points at.
dev_prune_host_tools() {
  local tools_root="$1" dir referenced
  [ -d "$tools_root" ] || return 0
  referenced="$(cat "${HOME}"/.local/lib/restless/releases/*/release.env 2>/dev/null || true)"
  for dir in "$tools_root"/*/; do
    dir="${dir%/}"
    case "$referenced" in
      *"${dir}/"*) ;;
      *) rm -rf -- "$dir" ;;
    esac
  done
}

reap_timer() {
  local unit_dir="${HOME}/.config/systemd/user"
  case "${1:-}" in
    install)
      if [ "$(uname -s)" = "Darwin" ]; then
        printf 'On macOS use infra/launchd/io.restless.reap.plist (see infra/launchd/README.md).\n'
        return 0
      fi
      mkdir -p "$unit_dir"
      sed "s#@REAP@#${STACK_SCRIPT_DIR}/restless-reap-scheduled#" \
        "${STACK_REPO_ROOT}/infra/systemd/restless-reap.service" >"${unit_dir}/restless-reap.service"
      cp "${STACK_REPO_ROOT}/infra/systemd/restless-reap.timer" "${unit_dir}/restless-reap.timer"
      systemctl --user daemon-reload
      systemctl --user enable --now restless-reap.timer
      printf 'Hourly resource check installed; latest report: ~/.restless/logs/reap-latest.log\n'
      ;;
    remove)
      systemctl --user disable --now restless-reap.timer 2>/dev/null || true
      rm -f "${unit_dir}/restless-reap.service" "${unit_dir}/restless-reap.timer"
      systemctl --user daemon-reload
      ;;
    *) usage >&2; return 2 ;;
  esac
}

case "$STACK_ACTION" in
  worktree)
    case "${STACK_ARGS[0]:-}" in
      new) dev_worktree_new "${STACK_ARGS[1]:-}" ;;
      stale) dev_worktree_stale ;;
      prune) dev_worktree_prune ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  promote) promote "${STACK_ARGS[@]}" ;;
  reap-timer) reap_timer "${STACK_ARGS[0]:-}" ;;
  dev) dev ;;
  doctor)
    # Report debt even when doctor fails — a degraded stack is exactly when
    # accumulated resources are worth seeing. doctor still owns the exit code.
    doctor_status=0
    doctor || doctor_status=$?
    report_resource_debt
    exit "$doctor_status"
    ;;
  help) usage ;;
  *) usage >&2; exit 2 ;;
esac
