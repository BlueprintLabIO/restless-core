+test('a card title never carries a URL and stays a short line', () => {
+	const raw =
+		'Sign in to Cloudflare as the owner and click Allow on the Wrangler consent page: https://dash.cloudflare.com/oauth2/auth?response_type=code&client_id=54d11594-84e4-41aa-b438-e81b8fa78ee7&code_challenge=xyz';
