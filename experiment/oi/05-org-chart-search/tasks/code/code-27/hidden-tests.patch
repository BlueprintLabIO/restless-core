+		ownerTitle(raw),
+		'Sign in to Cloudflare as the owner and click Allow on the Wrangler consent page'
+	);
+	assert.equal(ownerTitle('Open (https://example.com) now'), 'Open now');
+	const long = ownerTitle('word '.repeat(60));
+	assert.ok(long.length <= 120 && long.endsWith('…'), long);
+	assert.equal(
+		ownerTitle('Let Exec send email: [TEST] emails to your inbox'),
+		'Let Exec send email: [TEST] emails to your inbox'
+	);
+});
