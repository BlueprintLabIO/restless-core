{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.restless.run/core/company-collaboration/v1/native-documents-collaboration.protocol.schema.json",
  "title": "Restless Core native Documents collaboration connection",
  "description": "The bounded connection context available to the Core-owned collaboration sidecar after a short-lived token is verified. The WebSocket carries Yjs v1 document-body sync and document-local awareness only; company metadata, comments, Work, Authority and Runtime traffic stay outside this channel.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "company_id",
    "document_id",
    "actor_id",
    "session_id",
    "access",
    "channel_scope"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "schema_version": {
      "const": 1
    },
    "company_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "access": {
      "type": "string",
      "enum": [
        "read",
        "write"
      ]
    },
    "channel_scope": {
      "const": "document-body-and-awareness-only"
    }
  }
}
