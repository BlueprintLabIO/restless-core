{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.restless.run/core/company-collaboration/v1/native-documents-collaboration.token.schema.json",
  "title": "Restless Core native Documents collaboration token claims",
  "description": "Claims in a Core-issued, short-lived collaboration token. The verifier binds the claims to the exact company and document route, refuses expired or replayed sessions, and enforces the 15-to-120-second lifetime declared by the hosting descriptor before loading document content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iss",
    "aud",
    "sub",
    "company_id",
    "document_id",
    "actor_id",
    "access",
    "iat",
    "nbf",
    "exp",
    "jti"
  ],
  "properties": {
    "iss": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "aud": {
      "const": "restless-native-documents-collaboration"
    },
    "sub": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "company_id": {
      "type": "string",
      "format": "uuid"
    },
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "access": {
      "type": "string",
      "enum": [
        "read",
        "write"
      ]
    },
    "iat": {
      "type": "integer",
      "minimum": 1
    },
    "nbf": {
      "type": "integer",
      "minimum": 1
    },
    "exp": {
      "type": "integer",
      "minimum": 1
    },
    "jti": {
      "type": "string",
      "format": "uuid"
    }
  }
}
