{
  "name": "@restless/landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "sync:assets": "node scripts/sync-assets.mjs",
    "dev": "npm run sync:assets && vite dev --port 5174 --strictPort",
    "build": "npm run sync:assets && vite build",
    "preview": "vite preview --port 5174 --strictPort",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@lucide/svelte": "^1.31.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
