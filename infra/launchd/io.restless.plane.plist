<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The owner's account plane, supervised.

  Cross-layer contract §1.4.2: starting the account plane is not waking a
  company. The plane holds credentials but performs no work until asked, so it
  should simply be running whenever the owner is logged in — the CLI and the
  cockpit are its clients, and neither should have to start it. Waking a cell
  runs agents and spends money, and stays a deliberate act (`restless up`).

  Install:

    cp infra/launchd/io.restless.plane.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/io.restless.plane.plist

  Remove:

    launchctl bootout gui/$(id -u)/io.restless.plane
    rm ~/Library/LaunchAgents/io.restless.plane.plist

  ProgramArguments carries an absolute path because launchd runs with a minimal
  environment and no working directory; update it if the checkout moves.

  This plist deliberately sets no RESTLESS_HOME: the supervised plane is the
  owner's one plane, on the default home. Experiment installations remain
  explicit, started by hand with their own RESTLESS_HOME and
  RESTLESS_PORT_OFFSET, and are a test-harness affordance rather than part of
  the owner's vocabulary.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.restless.plane</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/yao/Learning/restless/restless-core/target/debug/restlessd</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/yao/Learning/restless/restless-core</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- The plane is the owner's resident service: bring it back if it dies. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- A plane that cannot boot (unreachable database, no admitted provider)
         must not spin: back off rather than retrying in a tight loop. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/tmp/restless-plane.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/restless-plane.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
