# Restless Company computer — a quiet, useful work surface with a warm canvas,
# blue active state, and slate chrome.

# Background 1: panel
rounded = 8
border_width = 0
background_color = #222d3b 98
border_color = #222d3b 100

# Background 2: active task
rounded = 6
border_width = 1
background_color = #315f91 100
border_color = #5888bb 85

# Panel
panel_monitor = all
panel_position = bottom center horizontal
panel_size = 100% 36
panel_margin = 0 0
panel_padding = 8 3 8
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_layer = top
strut_policy = follow_size
panel_items = LTSC

# Launchers
launcher_padding = 3 5 3
launcher_background_id = 0
launcher_icon_background_id = 0
launcher_icon_size = 22
launcher_icon_theme = Adwaita
launcher_item_app = /usr/share/applications/company-browser.desktop
launcher_item_app = /usr/share/applications/pcmanfm.desktop
launcher_item_app = /usr/share/applications/company-terminal.desktop
launcher_item_app = /usr/share/applications/company-godot.desktop
# A project may publish one deliberate `.desktop` launcher here (for example,
# "Play Swift Arrival"). Do not scan all system applications: the taskbar is
# a small, owner-ready surface rather than an app catalogue.
launcher_apps_dir = /company/home/.local/share/applications

# Taskbar and tasks
taskbar_mode = single_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 4 3 4
taskbar_background_id = 0
taskbar_active_background_id = 0
task_icon = 1
task_text = 1
task_centered = 0
task_maximum_size = 220 30
task_padding = 8 3 8
task_background_id = 0
task_active_background_id = 2
task_font = Inter 10
task_font_color = #e8e7e2 82
task_active_font_color = #ffffff 100
task_iconified_font_color = #bdc6d2 68

# System tray
systray_padding = 3 2 3
systray_background_id = 0
systray_icon_size = 16

# Clock
time1_format = %H:%M
time1_font = DejaVu Sans Mono 10
clock_font_color = #f0eee9 94
clock_padding = 10 0
clock_background_id = 0
clock_tooltip = %A, %d %B

# Mouse behaviour
mouse_middle = none
mouse_right = close
mouse_scroll_up = toggle_iconify
mouse_scroll_down = iconify
