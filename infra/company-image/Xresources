! Consistent, comfortable pointer size across X11-native applications.
Xcursor.theme: DMZ-White
Xcursor.size: 24

! Bridge Light companion terminal: dark slate, clear text, and blue selection.
xterm*faceName: DejaVu Sans Mono
xterm*faceSize: 12
xterm*background: #202630
xterm*foreground: #e7edf5
xterm*cursorColor: #8ab4dc
xterm*highlightColor: #365473
xterm*highlightTextColor: #ffffff
xterm*internalBorder: 12
xterm*rightScrollBar: true
xterm*scrollBar: false
xterm*saveLines: 10000
xterm*scrollTtyOutput: false
xterm*color0: #202630
xterm*color1: #ef6a65
xterm*color2: #82c48b
xterm*color3: #e9c46a
xterm*color4: #7fb3e5
