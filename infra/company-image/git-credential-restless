#!/bin/sh
# Git credential helper for a secret injected into one governed effect child.
# Git sends request fields on stdin and reads credential fields on stdout. The
# helper never stores, logs, or accepts the credential in argv.
set -eu

case "${1:-}" in
	get)
		if [ -z "${RESTLESS_GIT_PASSWORD:-}" ]; then
			# No governed credential is available in this process. Returning no
			# credential lets Git continue with an ordinary anonymous read; a
			# private remote will still reject that request normally. Do not turn
			# installing this helper into a blanket requirement for every fetch.
			exit 0
		fi
		printf 'password=%s\n\n' "$RESTLESS_GIT_PASSWORD"
		;;
	store|erase)
		# A governed effect uses an ephemeral credential. It must never create
		# persistent Git credential state in the company computer.
		;;
	*)
		printf 'usage: git-credential-restless get|store|erase\n' >&2
		exit 2
		;;
esac
