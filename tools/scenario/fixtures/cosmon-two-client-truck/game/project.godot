; Engine configuration file.
; This test-world fixture deliberately uses only a small Node2D scene so the Windows export proves
; the installed toolchain without turning this package into a production game architecture.
config_version=5

[application]
config/name="Cosmon Two-Client Truck Test"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=960
window/size/window_height_override=540

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
