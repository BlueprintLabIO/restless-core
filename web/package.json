{
	"name": "@restless/web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "npm@11.19.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run build:plane-ui",
		"build:plane-ui": "vite build -c vite.plane-ui.config.ts",
		"preview": "vite preview",
		"test": "node --test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:type && npm run check:ui && npm run check:document-search",
		"check:type": "node scripts/check-type.mjs",
		"check:ui": "node scripts/check-ui-boundary.mjs",
		"check:document-search": "node scripts/check-document-search.mjs",
		"pack:ui": "node scripts/pack-ui.mjs",
		"smoke:ui": "node scripts/smoke-ui-artifact.mjs",
		"verify:office": "node scripts/verify-office.mjs",
		"office:art": "node scripts/generate-office-art.mjs",
		"verify:inbox": "node scripts/verify-inbox-actions.mjs",
		"verify:overlays": "node scripts/verify-overlays.mjs",
		"verify:reader": "node scripts/verify-reader-corpus.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"verify:markdown": "node scripts/verify-streaming-markdown.mjs",
		"verify:math": "node scripts/verify-math.mjs",
		"pack:office": "node scripts/pack-office.mjs",
		"verify:quality": "node scripts/verify-product-quality.mjs"
	},
	"devDependencies": {
		"@hocuspocus/server": "^4.6.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"axe-core": "4.14.0",
		"playwright": "1.63.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^5.9.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/silkscreen": "^5.3.0",
		"@hocuspocus/provider": "^4.6.0",
		"@leeoniya/ufuzzy": "1.0.19",
		"@lucide/svelte": "^1.31.0",
		"@odoo/o-spreadsheet": "19.0.51",
		"@odoo/owl": "2.8.2",
		"@tanstack/svelte-query": "^6.1.41",
		"@tiptap/core": "^3.31.3",
		"@tiptap/extension-collaboration": "^3.31.3",
		"@tiptap/extension-collaboration-caret": "^3.31.3",
		"@tiptap/extension-drag-handle": "^3.31.3",
		"@tiptap/extension-node-range": "^3.31.3",
		"@tiptap/extension-task-item": "^3.31.3",
		"@tiptap/extension-task-list": "^3.31.3",
		"@tiptap/extension-unique-id": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"dompurify": "^3.4.17",
		"fflate": "^0.8.2",
		"jszip": "^3.10.2",
		"mammoth": "^1.13.0",
		"svelte-streamdown": "4.2.0",
		"yjs": "^13.6.32"
	},
	"overrides": {
		"katex": "0.18.2",
		"@sveltejs/kit": {
			"cookie": "0.7.2"
		}
	}
}
