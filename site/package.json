{
  "name": "@restless/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "quality": "node scripts/corpus-check.mjs && node scripts/quality-gate.mjs",
    "quality:portable": "node scripts/corpus-check.mjs --locators-only && node scripts/quality-gate.mjs",
    "verify": "npm run quality && npm run check && npm run build",
    "verify:portable": "npm run quality:portable && npm run check && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "astro": "7.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.3"
  }
}
