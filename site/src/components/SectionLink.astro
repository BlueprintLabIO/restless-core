---
interface Props {
  href: string;
  title: string;
  description: string;
  index: string;
}

const { href, title, description, index } = Astro.props;
---

<a class="section-link" href={href}>
  <span class="section-link-index" aria-hidden="true">{index}</span>
  <span class="section-link-copy">
    <strong>{title}</strong>
    <span>{description}</span>
  </span>
  <span class="section-link-arrow" aria-hidden="true">↗</span>
</a>
