---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'findings'>[];
  compact?: boolean;
}

const { entries, compact = false } = Astro.props;
const visible = compact ? entries.slice(0, 3) : entries;
---

<ol class="article-list">
  {visible.map((entry, index) => (
    <li>
      <a href={`/findings/${entry.id}/`}>
        <span class="article-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <span class="article-main">
          <span class="article-title">{entry.data.title}</span>
          <span class="article-deck">{entry.data.deck}</span>
        </span>
        <span class="article-meta">
          <time datetime={entry.data.publishedAt.toISOString()}>
            {entry.data.publishedAt.toLocaleDateString('en-AU', { day: '2-digit', month: 'short', year: 'numeric' })}
          </time>
          <span>{entry.data.readTime}</span>
        </span>
        <span class="article-arrow" aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ol>
