<figure class="responsibility-figure">
  <figcaption>One line of accountability. Production stays below the lead.</figcaption>
  <svg viewBox="0 0 720 472" role="img" aria-labelledby="rail-title rail-description">
    <title id="rail-title">Restless responsibility map</title>
    <desc id="rail-description">
      The owner gives a mandate to an available Exec. Exec appoints accountable leads. Each lead
      supervises Staff who produce the work. Material evidence returns on the same responsibility line.
    </desc>

    <path class="rail" d="M92 70 H360 V154 M360 154 H584 M360 154 V270 H584 M360 270 V388 H584" />
    <path class="signal" d="M92 70 H360 V154 M360 154 H584" />

    <g class="rail-node owner" tabindex="0">
      <title>Owner: mandate, taste, authority and final judgment</title>
      <rect x="28" y="32" width="152" height="76" />
      <text x="48" y="63" class="node-name">Owner</text>
      <text x="48" y="86" class="node-detail">judgment + authority</text>
    </g>

    <g class="rail-node exec" tabindex="0">
      <title>Exec: stays available and dispatches each executable outcome</title>
      <rect x="284" y="116" width="152" height="76" />
      <text x="304" y="147" class="node-name">Exec</text>
      <text x="304" y="170" class="node-detail">portfolio dispatch</text>
    </g>

    <g class="rail-node lead-a" tabindex="0">
      <title>Lead: owns the outcome, supervises production and judges the result</title>
      <rect x="508" y="116" width="180" height="76" />
      <text x="528" y="147" class="node-name">Lead</text>
      <text x="528" y="170" class="node-detail">outcome supervisor</text>
    </g>

    <g class="rail-node lead-b" tabindex="0">
      <title>Another lead: owns an independently judgeable outcome</title>
      <rect x="508" y="232" width="180" height="76" />
      <text x="528" y="263" class="node-name">Lead</text>
      <text x="528" y="286" class="node-detail">separate outcome</text>
    </g>

    <g class="rail-node staff-a" tabindex="0">
      <title>Staff: produces an attributable end-to-end contribution</title>
      <rect x="508" y="350" width="180" height="76" />
      <text x="528" y="381" class="node-name">Staff</text>
      <text x="528" y="404" class="node-detail">does the work</text>
    </g>

    <circle class="junction" cx="360" cy="154" r="7" />
    <circle class="junction" cx="360" cy="270" r="7" />
    <circle class="junction" cx="584" cy="388" r="7" />
  </svg>
</figure>
