---
import { brand } from '../config';

const path = Astro.url.pathname;
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${brand.name} home`}>
    <span class="wordmark-mark" aria-hidden="true"></span>
    <span>{brand.name}</span>
  </a>
  <nav aria-label="Primary navigation">
    <a href="/" aria-current={path === '/' ? 'page' : undefined}>Company</a>
    <a href="/findings/" aria-current={path.startsWith('/findings') ? 'page' : undefined}>Findings</a>
    <a class="source-link" href={brand.repository}>Source <span aria-hidden="true">↗</span></a>
  </nav>
</header>
