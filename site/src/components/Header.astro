---
import { brand, navigation } from '../config';
import MatrixGlyph from './MatrixGlyph.astro';

const path = Astro.url.pathname;
const mark = ['11110', '10001', '10001', '11110', '10100', '10010', '10001'] as const;
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${brand.name} home`}>
    <MatrixGlyph rows={mark} size={10} />
    <span>{brand.name}</span>
  </a>
  <nav class="primary-nav" aria-label="Primary navigation">
    {navigation.map((item) => (
      <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
  <details class="mobile-menu">
    <summary>Explore <span aria-hidden="true">+</span></summary>
    <nav aria-label="Mobile navigation">
      {navigation.map((item) => (
        <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </details>
</header>
