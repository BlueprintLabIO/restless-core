---
interface Props {
  active?: 'product' | 'how' | 'research' | 'compare' | 'journal';
}

const { active } = Astro.props;
const links = [
  { href: '/product/', label: 'Product', key: 'product' },
  { href: '/how-it-works/', label: 'How it works', key: 'how' },
  { href: '/research/', label: 'Research', key: 'research' },
  { href: '/compare/', label: 'Compare', key: 'compare' },
  { href: '/journal/', label: 'Journal', key: 'journal' }
] as const;
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Restless home"><span aria-hidden="true">R/</span>Restless</a>
  <nav aria-label="Primary navigation">
    {links.map((link) => (
      <a href={link.href} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
  <a class="site-status status-chip" href="/research/" title="Restless is an active research programme, not a general-availability claim">
    Research stage
  </a>
</header>
