<figure class="outcome-line">
  <figcaption>
    Intent enters once. Evidence and exceptions move along the accountable line.
  </figcaption>
  <svg viewBox="0 0 1200 310" role="img" aria-labelledby="outcome-title outcome-description">
    <title id="outcome-title">The Restless outcome line</title>
    <desc id="outcome-description">
      The owner supplies an outcome. Exec appoints an accountable lead. Staff produces the work. The
      lead reviews it in its native form and returns only the judgment that belongs to the owner.
    </desc>

    <path class="outcome-track" d="M78 155 H1122" />
    <path class="outcome-beam" d="M78 155 H1122" />

    <g class="outcome-node" tabindex="0" transform="translate(38 100)">
      <title>Owner: gives the outcome, authority and final judgment</title>
      <rect width="176" height="110" />
      <text x="22" y="43" class="outcome-name">Outcome</text>
      <text x="22" y="72" class="outcome-detail">intent + authority</text>
    </g>
    <g class="outcome-node" tabindex="0" transform="translate(278 100)">
      <title>Exec: dispatches the outcome and returns to portfolio availability</title>
      <rect width="176" height="110" />
      <text x="22" y="43" class="outcome-name">Exec</text>
      <text x="22" y="72" class="outcome-detail">appoints ownership</text>
    </g>
    <g class="outcome-node" tabindex="0" transform="translate(518 100)">
      <title>Lead: preserves the mission, supervises and redirects</title>
      <rect width="176" height="110" />
      <text x="22" y="43" class="outcome-name">Lead</text>
      <text x="22" y="72" class="outcome-detail">supervises outcome</text>
    </g>
    <g class="outcome-node" tabindex="0" transform="translate(758 100)">
      <title>Staff: produces the attributable work</title>
      <rect width="176" height="110" />
      <text x="22" y="43" class="outcome-name">Staff</text>
      <text x="22" y="72" class="outcome-detail">does the work</text>
    </g>
    <g class="outcome-node outcome-node--return" tabindex="0" transform="translate(998 100)">
      <title>Review: the native result and exact judgment return to the owner</title>
      <rect width="164" height="110" />
      <text x="22" y="43" class="outcome-name">Review</text>
      <text x="22" y="72" class="outcome-detail">native result</text>
    </g>
  </svg>
</figure>
