---
import MatrixGlyph from './MatrixGlyph.astro';

const glyphs = {
  r: ['11110', '10001', '10001', '11110', '10100', '10010', '10001'],
  alert: ['00000', '01110', '10001', '10101', '10001', '01110', '00000'],
  briefcase: ['01110', '01010', '11111', '10001', '10101', '10001', '11111'],
  group: ['01010', '01010', '00000', '11111', '10101', '10101', '10101'],
  key: ['01100', '10010', '10010', '01111', '00010', '00011', '00000']
} as const;
---

<figure class="product-window" aria-labelledby="product-window-caption">
  <div class="product-window-shell" aria-hidden="true">
    <header class="product-window-bar">
      <div class="product-window-brand">
        <MatrixGlyph rows={glyphs.r} size={10} />
        <strong>RESTLESS</strong>
        <span>/ Northstar</span>
      </div>
      <nav aria-label="Illustrated owner surfaces">
        <span><MatrixGlyph rows={glyphs.alert} size={8} />Attention</span>
        <span class="active"><MatrixGlyph rows={glyphs.briefcase} size={8} />Work</span>
        <span><MatrixGlyph rows={glyphs.group} size={8} />People</span>
        <span><MatrixGlyph rows={glyphs.key} size={8} />Company</span>
      </nav>
      <span class="product-window-exec"><i></i>Exec</span>
    </header>
    <div class="product-window-body">
      <section class="product-work-pane">
        <header><span>Current outcome</span><strong>Launch the evidence site</strong></header>
        <div class="product-work-result">
          <span class="result-status"><i></i>Ready for review</span>
          <h3>The native result is waiting.</h3>
          <p>Open the live site at the exact page and state that needs your judgment.</p>
          <span class="product-window-button">Open result <span aria-hidden="true">↗</span></span>
        </div>
        <footer>
          <span><b>Lead</b> Product release</span>
          <span><b>Evidence</b> 6 checks</span>
          <span><b>Owner decision</b> Publish</span>
        </footer>
      </section>
      <aside class="product-exec-rail">
        <header><i></i><span><strong>Exec</strong><small>Available</small></span></header>
        <div class="product-exec-message">
          <p>The release lead finished the site and prepared the live review.</p>
          <p>I kept two limits visible: model generality and founder rescue.</p>
        </div>
        <div class="product-exec-composer">Ask about this outcome <span>↗</span></div>
      </aside>
    </div>
  </div>
  <figcaption id="product-window-caption">
    The owner surface stays calm because the organisation operates below it.
  </figcaption>
</figure>
