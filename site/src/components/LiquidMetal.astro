<figure class="liquid-metal" aria-labelledby="liquid-metal-caption">
  <svg viewBox="0 0 720 720" role="img" aria-labelledby="liquid-metal-title liquid-metal-description">
    <title id="liquid-metal-title">A living metal company form</title>
    <desc id="liquid-metal-description">
      A reflective abstract form moves around one stable core, representing a company that can
      reorganise around an outcome without losing accountability.
    </desc>
    <defs>
      <radialGradient id="metal-face" cx="34%" cy="26%" r="78%">
        <stop offset="0" stop-color="#ffffff" />
        <stop offset="0.16" stop-color="#aeb9c9" />
        <stop offset="0.31" stop-color="#f8fbff" />
        <stop offset="0.5" stop-color="#4c596d" />
        <stop offset="0.66" stop-color="#e9eef7" />
        <stop offset="0.82" stop-color="#2f6ca8" />
        <stop offset="1" stop-color="#111722" />
      </radialGradient>
      <linearGradient id="metal-rim" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ffffff" />
        <stop offset="0.42" stop-color="#73839a" />
        <stop offset="0.7" stop-color="#f9fbff" />
        <stop offset="1" stop-color="#6447a6" />
      </linearGradient>
      <filter id="liquid-surface" x="-30%" y="-30%" width="160%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.011 0.017" numOctaves="2" seed="17" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="24" xChannelSelector="R" yChannelSelector="B" result="warped" />
        <feGaussianBlur in="warped" stdDeviation="0.45" result="soft" />
        <feSpecularLighting in="soft" surfaceScale="7" specularConstant="1.05" specularExponent="24" lighting-color="#ffffff" result="light">
          <fePointLight x="160" y="80" z="220" />
        </feSpecularLighting>
        <feComposite in="light" in2="soft" operator="in" result="lit" />
        <feBlend in="soft" in2="lit" mode="screen" />
      </filter>
      <filter id="metal-shadow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="22" />
      </filter>
    </defs>

    <ellipse class="metal-shadow" cx="370" cy="570" rx="220" ry="62" />
    <circle class="metal-orbit metal-orbit--wide" cx="360" cy="360" r="286" />
    <circle class="metal-orbit metal-orbit--tight" cx="360" cy="360" r="236" />

    <g class="metal-core" filter="url(#liquid-surface)">
      <path
        fill="url(#metal-face)"
        d="M179 192C232 113 363 91 454 130C551 171 615 276 594 374C573 474 475 564 370 588C268 611 151 562 111 465C73 373 117 284 179 192Z"
      />
      <path
        class="metal-rim"
        fill="none"
        stroke="url(#metal-rim)"
        stroke-width="9"
        d="M185 204C240 127 360 105 448 141C541 179 597 278 579 369C560 462 470 546 373 570C279 593 169 548 130 461C92 375 128 286 185 204Z"
      />
    </g>

    <g class="metal-droplets" fill="url(#metal-face)" filter="url(#liquid-surface)">
      <circle cx="586" cy="176" r="36" />
      <circle cx="126" cy="532" r="22" />
      <circle cx="606" cy="506" r="14" />
    </g>

    <circle class="metal-anchor" cx="360" cy="360" r="8" />
  </svg>
  <figcaption id="liquid-metal-caption">Organisation changes. Accountability holds.</figcaption>
</figure>
