---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Restless">
  <section class="not-found">
    <p class="error-code">404</p>
    <h1>This path does not close.</h1>
    <p>The page may have moved, or the evidence was never published here.</p>
    <a class="primary-action" href="/">Return home <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
