---
import BaseLayout from '../layouts/BaseLayout.astro';
import JournalList from '../components/JournalList.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('journal')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Restless"
  description="Restless is an autonomous-company control plane that brings prepared judgements back to the owner."
>
  <section class="hero-shell">
    <div class="hero-copy">
      <span class="status-chip research-state" title="This is an active research direction, not a general-availability claim">Research stage</span>
      <h1>Give your company work.<br /><em>Keep your day.</em></h1>
      <p class="hero-lede">Restless organises real work, keeps one accountable owner close to the outcome, and returns only the decisions that remain yours.</p>
      <div class="text-actions">
        <a href="/product/">See the owner experience <span aria-hidden="true">↗</span></a>
        <a href="/research/">Inspect the research <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <aside class="owner-moment" aria-labelledby="owner-moment-title">
      <div class="moment-topline"><span>Prepared owner moment</span><span>Ready for judgement</span></div>
      <div class="moment-section">
        <h2 id="owner-moment-title">Keep the launch date with a smaller first cohort?</h2>
        <p>The company has already found the weak onboarding path, repaired it, and checked the live build.</p>
      </div>
      <dl class="moment-record">
        <div><dt>Direction</dt><dd>Protect the launch while reducing the first cohort.</dd></div>
        <div><dt>Prepared</dt><dd>Evidence, repaired path, trade-offs and rollback point.</dd></div>
        <div><dt>Yours</dt><dd>Choose the release posture. Nothing consequential has been sent.</dd></div>
      </dl>
      <p class="moment-outcome">The last mile is a decision, not an operations assignment.</p>
    </aside>
  </section>

  <section class="wide-statement">
    <h2>Work leaves your desk.<br /><em>Judgement comes back.</em></h2>
    <div class="three-exchange">
      <article><h3>You set direction</h3><p>Mission, priorities, limits and taste. No task choreography.</p></article>
      <article><h3>The company handles work</h3><p>Exec delegates a coherent outcome. Staff produces it. The lead preserves the outcome.</p></article>
      <article><h3>You receive the last mile</h3><p>A native result, the exact decision and the prepared state required to make it.</p></article>
    </div>
  </section>

  <section class="blue-band">
    <div><h2>A company is more than a place to manage agents.</h2></div>
    <div><p>Files hold the work. Git marks meaningful checkpoints. Deterministic boundaries govern authority, money and public effects. Intelligence handles the judgement between them.</p><a class="inverse-link" href="/how-it-works/">Follow one outcome <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="journal-preview">
    <div class="section-heading"><h2>What the work changed</h2><p>Public research notes from a programme that keeps its negative evidence.</p></div>
    <JournalList entries={entries.slice(0, 4)} />
    <a class="underline-link" href="/journal/">Open the full journal <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
