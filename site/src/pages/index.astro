---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LiquidMetal from '../components/LiquidMetal.astro';
import ProductWindow from '../components/ProductWindow.astro';
import ArticleList from '../components/ArticleList.astro';

const entries = (await getCollection('findings')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section class="machine-hero">
    <div class="machine-hero-copy">
      <h1>The company handles the work. <span>You keep the judgment.</span></h1>
      <p>Set the direction. Restless keeps the work moving, repairs what breaks and improves how the company operates. You return for the decisions only you can make.</p>
      <div class="hero-actions">
        <a class="primary-action" href="/product/">See the product <span aria-hidden="true">↗</span></a>
        <a class="text-action" href="/findings/">Inspect the evidence</a>
      </div>
    </div>
    <LiquidMetal />
  </section>

  <section class="product-reveal" aria-labelledby="product-reveal-heading">
    <div class="spare-heading">
      <h2 id="product-reveal-heading">Delegate the outcome. Not the workflow.</h2>
      <p>Restless plans, staffs, supervises and completes the work. The exact result arrives ready to run, inspect or approve.</p>
    </div>
    <ProductWindow />
  </section>

  <section class="owner-contract" aria-labelledby="owner-contract-heading">
    <div class="owner-contract-copy">
      <h2 id="owner-contract-heading">You should remain the owner, not become the workflow.</h2>
      <p>Restless does every machine-doable step, then brings back the live result or the exact human-only decision in context.</p>
    </div>
    <div class="owner-contract-sides">
      <div>
        <h3>You provide</h3>
        <p>Direction, authority, judgment and taste.</p>
      </div>
      <div>
        <h3>The company returns</h3>
        <p>A native outcome, real evidence and a prepared last mile.</p>
      </div>
    </div>
  </section>

  <section class="organisation-bet" aria-labelledby="organisation-bet-heading">
    <div class="spare-heading">
      <h2 id="organisation-bet-heading">The missing product is not a smarter agent. It is an organisation.</h2>
      <p>Tools, memory and parallel agents create capability. They do not create accountability or continuity. Restless keeps one line of responsibility from owner intent to inspected outcome.</p>
    </div>
    <ol class="organisation-motions">
      <li>
        <span aria-hidden="true">01</span>
        <h3>Explore</h3>
        <p>Find credible paths without waiting for a perfect brief.</p>
      </li>
      <li>
        <span aria-hidden="true">02</span>
        <h3>Execute</h3>
        <p>Move the best-supported path through real tools and company work.</p>
      </li>
      <li>
        <span aria-hidden="true">03</span>
        <h3>Repair</h3>
        <p>Keep useful progress, redirect failed work and recover without returning the whole problem.</p>
      </li>
      <li>
        <span aria-hidden="true">04</span>
        <h3>Improve</h3>
        <p>Turn outcomes into better roles, tools and methods, then remove what stops helping.</p>
      </li>
    </ol>
  </section>

  <section class="proof-moment" aria-labelledby="proof-moment-heading">
    <div class="spare-heading">
      <h2 id="proof-moment-heading">This bet has to beat one strong agent.</h2>
      <p>If the organisation cannot produce more accepted work with less owner attention than one strong agent or a loose team, it has not earned its complexity.</p>
    </div>
    <div class="proof-numbers">
      <div><strong>90 / 90</strong><span>units closed across four isolated departments</span></div>
      <div><strong>2.83×</strong><span>throughput when an immediate backlog repaid a second worker</span></div>
    </div>
    <a class="text-action" href="/research/">Read the method and limits</a>
  </section>

  <section class="category-break" aria-labelledby="category-heading">
    <div>
      <h2 id="category-heading">A workspace helps you work with agents.</h2>
      <p>Sessions, shared context and workflows are useful when the human still runs the process.</p>
    </div>
    <div>
      <h2>Restless keeps the business working without making you its manager.</h2>
      <p>It starts with an owner responsibility, keeps accountability coherent and returns the native result.</p>
      <a href="/compare/">See the sourced comparison <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="latest-section latest-section--quiet" aria-labelledby="latest-heading">
    <div class="spare-heading">
      <h2 id="latest-heading">What the work taught us</h2>
      <p>Failures included.</p>
    </div>
    <ArticleList entries={entries.slice(0, 3)} compact />
  </section>
</BaseLayout>
