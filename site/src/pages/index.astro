---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import OutcomeLine from '../components/OutcomeLine.astro';
import RunLedger from '../components/RunLedger.astro';
import ArticleList from '../components/ArticleList.astro';
import SectionLink from '../components/SectionLink.astro';

const entries = (await getCollection('findings')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <section class="home-hero">
    <div class="home-hero-title">
      <h1>
        <span>The company handles the work.</span>
        <span>You keep the judgment.</span>
      </h1>
    </div>
    <div class="home-hero-copy">
      <p>
        Give Restless a real outcome. Its Exec appoints accountable leads, Staff works inside a
        persistent company computer, and the system returns something you can run, inspect or approve.
      </p>
      <div class="hero-actions">
        <a class="primary-action" href="/product/">Understand the product <span aria-hidden="true">↗</span></a>
        <a class="text-action" href="/findings/">Read what we have proved</a>
      </div>
    </div>
  </section>

  <section class="outcome-section" aria-label="How an outcome moves through Restless">
    <OutcomeLine />
  </section>

  <section class="orientation-section" aria-labelledby="orientation-heading">
    <div class="orientation-intro">
      <h2 id="orientation-heading">Five questions. Five places to answer them.</h2>
      <p>
        The product promise, operating model, research record and market position now have separate
        homes. Start with the question you actually have.
      </p>
    </div>
    <div class="section-links">
      <SectionLink index="01" href="/product/" title="What does it do?" description="The owner promise, useful work and current product boundary." />
      <SectionLink index="02" href="/how-it-works/" title="How does responsibility move?" description="Exec, leads, Staff, authority and the prepared last mile." />
      <SectionLink index="03" href="/research/" title="Why this organisation?" description="The method, current theory, observed evidence and open questions." />
      <SectionLink index="04" href="/compare/" title="Why is this different?" description="A sourced comparison with AI agents, workforce builders and role helpers." />
      <SectionLink index="05" href="/findings/" title="What happened in the runs?" description="Full findings, including invalid evaluations and product defects." />
    </div>
  </section>

  <section class="evidence-section" aria-labelledby="evidence-heading">
    <div class="wide-heading">
      <h2 id="evidence-heading">The promise is large. The claims stay narrow.</h2>
      <p>
        These are observations from controlled coordination runs. They are evidence for specific
        mechanisms, not proof that an autonomous company is finished.
      </p>
    </div>
    <RunLedger />
    <a class="inline-route" href="/research/">See the research method <span aria-hidden="true">↗</span></a>
  </section>

  <section class="status-section" aria-labelledby="status-heading">
    <div class="status-thesis">
      <h2 id="status-heading">Working theory, visible limits.</h2>
      <p>
        Wide company operation looks promising. Durable dispatch, terminal failure delivery and full
        self-dogfood remain live product tests.
      </p>
    </div>
    <div class="status-columns">
      <div>
        <h3>Observed</h3>
        <ul>
          <li>Independent queues can repay parallel Staff.</li>
          <li>Supervision can repair stale work after a real change.</li>
          <li>Several departments can operate without observed context leakage.</li>
        </ul>
      </div>
      <div>
        <h3>Still open</h3>
        <ul>
          <li>A whole release run without founder rescue.</li>
          <li>Generalisation beyond one model family and test world.</li>
          <li>Reliable response to real inbound signals and process replacement.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="latest-section" aria-labelledby="latest-heading">
    <div class="wide-heading">
      <h2 id="latest-heading">Latest findings</h2>
      <p>Short conclusions, exact boundaries and the failures we kept.</p>
    </div>
    <ArticleList entries={entries} compact />
    <a class="inline-route" href="/findings/">Read every finding <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
