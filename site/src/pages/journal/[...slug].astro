---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('journal');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'journal'> };
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.deck} active="journal">
  <article class="journal-article">
    <header class="article-header">
      <span class="status-chip" title={`Evidence state: ${entry.data.status}`}>{entry.data.status}</span>
      <h1>{entry.data.title}</h1>
      <p class="article-deck">{entry.data.deck}</p>
      <div class="article-meta"><span>{entry.data.readTime} read</span><span>{entry.data.experiments.join(' · ')}</span><time datetime={entry.data.publishedAt.toISOString()}>{entry.data.publishedAt.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}</time></div>
    </header>
    <div class="article-body"><Content /></div>
    <aside class="evidence-strip" aria-labelledby="evidence-title">
      <h2 id="evidence-title">Evidence used</h2>
      <p>{entry.data.thesis}</p>
      <ol>
        {entry.data.evidence.map((source) => (
          <li><strong>{source.label}</strong><code>{source.locator}</code><span>{source.scope}</span></li>
        ))}
      </ol>
      <p class="evidence-limit">Repository paths identify the exact source record. They support the article; they do not replace its limits.</p>
    </aside>
  </article>
</BaseLayout>
