---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';

const entries = (await getCollection('findings')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Findings | Restless"
  description="Observed results from building and testing an autonomous company control plane."
>
  <header class="archive-hero">
    <h1>Findings</h1>
    <p>
      Every note names the run, the evidence and the edge of the claim. Failed evaluations stay failed.
      Useful product evidence survives them.
    </p>
  </header>
  <section class="archive-body" aria-label="Published findings">
    <ArticleList entries={entries} />
  </section>
</BaseLayout>
